+package com.asak.backend.menu;
+
+import com.asak.backend.menu.dto.KioskMenuListItem;
+import java.util.List;
+import org.springframework.stereotype.Service;
+
+@Service
+public class KioskMenuCatalogService {
+
+    private static final List<KioskMenuListItem> MENU_CATALOG = List.of(
+            new KioskMenuListItem(364L, "스파이시 쉬림프 샌드위치", "NEW", "신메뉴", 8900, 464, "/assets/menu/364.png", true, false, List.of("NEW")),
+            new KioskMenuListItem(501L, "불고기 반미 샌드위치", "SANDWICH", "샌드위치", 7400, 510, "/assets/menu/501.png", true, false, List.of()),
+            new KioskMenuListItem(638L, "클래식 치킨 샌드위치", "SANDWICH", "샌드위치", 5900, 430, "/assets/menu/638.png", true, true, List.of()),
+            new KioskMenuListItem(768L, "그라브락스 연어 포케볼", "SALAD_BOWL", "샐러디·볼", 11400, 590, "/assets/menu/768.png", true, false, List.of()),
+            new KioskMenuListItem(908L, "칠리베이컨 곡물랩", "WRAP", "랩", 7400, 520, "/assets/menu/908.png", true, false, List.of()),
+            new KioskMenuListItem(1301L, "프로틴 치킨 볼", "PROTEIN", "프로틴", 9800, 610, "/assets/menu/1301.png", true, false, List.of("HIGH_PROTEIN"))
+    );
+
+    public List<KioskMenuListItem> getMenuList(String categoryCode) {
+        if (categoryCode == null || categoryCode.isBlank()) {
+            return MENU_CATALOG;
+        }
+
+        return MENU_CATALOG.stream()
+                .filter(menu -> menu.categoryCode().equalsIgnoreCase(categoryCode))
+                .toList();
+    }
+}
