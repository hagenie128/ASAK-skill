+package com.asak.backend.menu;
+
+import com.asak.backend.common.dto.ApiResponse;
+import com.asak.backend.menu.dto.KioskMenuListItem;
+import java.util.List;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.RestController;
+
+@RestController
+@RequestMapping("/api/kiosk")
+public class KioskMenuController {
+
+    private final KioskMenuCatalogService kioskMenuCatalogService;
+
+    public KioskMenuController(KioskMenuCatalogService kioskMenuCatalogService) {
+        this.kioskMenuCatalogService = kioskMenuCatalogService;
+    }
+
+    @GetMapping("/menuList")
+    public ApiResponse<List<KioskMenuListItem>> getMenuList(
+            @RequestParam(required = false) String categoryCode
+    ) {
+        return ApiResponse.ok(
+                "MENU_LIST_SUCCESS",
+                "Menu list retrieved successfully",
+                kioskMenuCatalogService.getMenuList(categoryCode)
+        );
+    }
+}
