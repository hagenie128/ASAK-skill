-// 학습용 자리표시자: 카테고리·메뉴·옵션 조회를 묶는 훅입니다.
+import { useCallback, useEffect, useState } from "react";
+import kioskMock from "../../public/mocks/kiosk.json";
+import { getKioskMenuList } from "@/api/menu";
+import {
+  toMenuCategories,
+  toMenuListViewModel,
+  toMockMenuListViewModel,
+} from "@/api/menuAdapter";
+
+const mockMenuList = toMockMenuListViewModel(kioskMock);
+
+/** Loads the canonical menu list while retaining the team's kiosk.json fallback. */
+export function useMenuList() {
+  const [state, setState] = useState({
+    categories: [],
+    menus: [],
+    status: "loading",
+    errorMessage: "",
+  });
+
+  const load = useCallback(async () => {
+    setState((previous) => ({ ...previous, status: "loading", errorMessage: "" }));
+    try {
+      const response = await getKioskMenuList();
+      setState({
+        categories: toMenuCategories(response),
+        menus: response.map(toMenuListViewModel),
+        status: "default",
+        errorMessage: "",
+      });
+    } catch {
+      setState({
+        ...mockMenuList,
+        status: "error",
+        errorMessage: "메뉴 정보를 불러오지 못해 임시 메뉴를 표시합니다.",
+      });
+    }
+  }, []);
+
+  useEffect(() => {
+    load();
+  }, [load]);
+
+  return { ...state, retry: load };
+}
