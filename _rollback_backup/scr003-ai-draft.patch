new file mode 100644
index 0000000..7b081e7
--- /dev/null
+++ b/src/api/menuAdapter.js
@@ -0,0 +1,41 @@
+const toCategoryId = (categoryCode) => String(categoryCode);
+
+export function toMenuListViewModel(menu) {
+  return {
+    menuId: menu.menuId,
+    categoryId: toCategoryId(menu.categoryCode),
+    name: menu.menuName,
+    price: menu.price,
+    imageUrl: menu.imageUrl,
+    baseKcal: menu.calories ?? 0,
+    isSoldOut: Boolean(menu.isSoldOut),
+    hasSoldOutIngredient: false,
+    soldOutBadges: [],
+  };
+}
+
+export function toMenuCategories(menus) {
+  const categories = new Map();
+  menus.forEach((menu) => {
+    const categoryId = toCategoryId(menu.categoryCode);
+    if (!categories.has(categoryId)) {
+      categories.set(categoryId, {
+        categoryId,
+        name: menu.displayCategoryName ?? menu.categoryCode,
+      });
+    }
+  });
+  return Array.from(categories.values());
+}
+
+export function toMockMenuListViewModel(kioskMock) {
+  return {
+    categories: kioskMock.categories.data.map((category) => ({
+      ...category,
+      categoryId: String(category.categoryId),
+    })),
+    menus: Object.values(kioskMock.menusByCategory)
+      .flatMap((response) => response.data)
+      .map((menu) => ({ ...menu, categoryId: String(menu.categoryId) })),
+  };
+}
