{
  "folders": [
    { "name": "ASAK-workspace", "path": "." },
    { "name": "ASAK", "path": "ASAK" },
    { "name": "ASAK-Kiosk", "path": "ASAK-Kiosk" },
    { "name": "ASAK-Admin", "path": "ASAK-Admin" },
    { "name": "ASAK-backend", "path": "ASAK-backend" },
    { "name": "ASAK-back (archive)", "path": "_archive/ASAK-back-archive" }
  ],
  "settings": {
    "git.autoRepositoryDetection": true,
    "git.detectSubmodules": true,
    "git.detectSubmodulesLimit": 10,
    "git.repositoryScanMaxDepth": 3,
    "git.scanRepositories": [
      ".",
      "ASAK",
      "ASAK-Kiosk",
      "ASAK-Admin",
      "ASAK-backend",
      "_archive/ASAK-back-archive"
    ],
    "scm.alwaysShowRepositories": true,
    "scm.repositories.visible": 10,
    "java.compile.nullAnalysis.mode": "automatic"
  }
}
